# ============================================================
# SIET Academic Background Verification Portal
# Backend Environment Configuration – EXAMPLE FILE
#
# Copy this file to .env and fill in your local values.
# NEVER commit the real .env file to version control.
# NEVER put real credentials in this example file.
# ============================================================

# ----- Application -----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ----- Server -----
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# Development default: Vite dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Database (Parthiban's PostgreSQL) -----
# Development Default: SQLite
DATABASE_URL=sqlite+aiosqlite:///./dev_local.db
# PostgreSQL Example: postgresql+asyncpg://USER:PASSWORD@localhost:5432/siet_bgv

# ----- Email (OTP delivery) -----
# Sprint 1: OTP is logged to console in development (DEV_MOCK_OTP=true)
# Sprint 2+: Set real SMTP credentials and DEV_MOCK_OTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_NAME=SIET Background Verification
SMTP_FROM_EMAIL=noreply@siet.ac.in
DEV_MOCK_OTP=true

# ----- OTP Settings -----
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ----- Admin Authentication -----
ADMIN_USERNAME=admin
ADMIN_HMAC_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY
ADMIN_PASSWORD_HASH=GENERATE_HASH_USING_HMAC_SHA256

# ----- Payment Gateway -----
# Sprint 1: Payment is STUBBED (DEV_MOCK_PAYMENT=true)
# Sprint 2+: Set real gateway credentials after college approval
# DO NOT choose or commit a payment gateway without college approval
PAYMENT_GATEWAY_KEY_ID=your_razorpay_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_razorpay_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_webhook_signature_secret
DEV_MOCK_PAYMENT=true

# ----- Verification -----
# Base URL for QR code references in reports (Sprint 2+)
VERIFICATION_BASE_URL=http://localhost:8000
