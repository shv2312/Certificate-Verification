# ============================================================
# SIET Academic Background Verification Portal – .gitignore
# ============================================================

# ----- Python / Pytest / Cache -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Distribution / packaging
dist/
build/
MANIFEST

# ----- Environment & Secret Artifacts -----
# NEVER commit real .env files or credentials
.env
.env.*
.env.local
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.crt
secrets.json
credentials.json
*Pass*.txt
*pass*.txt
scratch_*.json

# ----- Database / Data -----
# Never commit real DB data
*.sqlite3
*.db
*.sql.gz
*.dump
*.backup
real_student_data/
production_exports/
college_data_import/

# ----- Node / Vite / Frontend -----
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.eslintcache
.next/
.nuxt/

# ----- Local Uploads & Static Assets -----
backend/uploads/
backend/uploads/*
!backend/uploads/.gitkeep

# ----- IDEs -----
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.user

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Docker -----
*.override.yml

# ----- Logs & Temporary -----
*.log
logs/
*.tmp
*.temp
scratch/

# ----- Dev / Scratch scripts (never commit) -----
scratch.py
update_constraints.py
test_connection.py
test_browser_int*.py
test_tracking.py
test_flow*.py

# ----- Student data (sensitive, never commit) -----
Student Data/
*.xlsx
*.xls
*.csv

# ----- Gemini / AI context docs -----
docs/GEM_PROJECT_MASTER_CONTEXT.md.txt
